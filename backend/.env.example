# --- Application ---
APP_NAME=AI Weekly News Platform
ENVIRONMENT=local
DEBUG=true
API_V1_PREFIX=/api/v1

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=ainews
POSTGRES_PASSWORD=ainews
POSTGRES_DB=ainews

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# --- AI providers (embeddings + LLM; used from Milestone 6 onward) ---
# Active provider. Currently Gemini free tier; set to "openai" to switch later.
EMBEDDING_PROVIDER=gemini
LLM_PROVIDER=gemini
EMBEDDING_DIM=1536

# Gemini (Google AI Studio free tier) — get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_CHAT_MODEL=gemini-2.0-flash

# OpenAI — leave blank until you switch providers.
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

# --- News providers (Milestone 4) ---
NEWS_QUERY=artificial intelligence
FETCH_MAX_PER_PROVIDER=50
# RSS works with no key. NewsAPI / GNews are enabled only when a key is set.
NEWSAPI_API_KEY=
GNEWS_API_KEY=
# Optional: override default feeds with a JSON list, e.g.
# RSS_FEEDS=["https://example.com/feed","https://other.com/rss"]
